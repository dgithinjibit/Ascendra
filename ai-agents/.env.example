# SyncSenta AI Agents Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# LLM Provider Selection
# Select nvidia, openai, groq, or gemini for model inference.
# With no LLM key the generation API returns a deterministic prescribed CBC fallback.
LLM_PROVIDER=nvidia

# NVIDIA NIM Configuration (primary scheme-generation provider)
# Keep the real value only in ai-agents/.env.local or your deployment secret manager.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_BUDGET=16384
NVIDIA_TOP_P=0.95
NVIDIA_TIMEOUT_SECONDS=120

# OpenAI Configuration (future production replacement; optional)
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TOP_P=0.95
OPENAI_TIMEOUT_SECONDS=120

# Gemini Configuration (optional local/provider fallback)
# Keep the real value only in .env.local or your deployment secret manager.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=120

# Groq Configuration (RECOMMENDED - FREE & FAST)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile  # or llama-3.1-8b-instant, gemma2-9b-it

# Ollama Configuration (local, requires GPU)
OLLAMA_BASE_URL=http://localhost:11434

# Dify Configuration (alternative cloud option)
DIFY_API_KEY=your_dify_api_key_here
DIFY_BASE_URL=https://api.dify.ai/v1

# Stellar Blockchain
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SCHOOL_SECRET_KEY=your_stellar_secret_key_here

# Database
DATABASE_URL=sqlite:///./syncsenta_agents.db
COUCHDB_URL=http://localhost:5984

# Voice and Multimodal
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
WHISPER_MODEL=base

# Performance
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300

# Cultural Settings
DEFAULT_LANGUAGE=english
CULTURAL_CONTEXT=kenyan
